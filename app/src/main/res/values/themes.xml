<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.MainApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/basic_2</item>
        <item name="colorAccent">@color/basic_2</item>
        <item name="color">@color/white</item>
        <item name="background">@color/basic_2</item>
        <item name="tickColor">@color/basic_2</item>
        <item name="trackColor">@color/basic_2</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorError">@color/dark</item>
        <item name="colorOnError">@color/basic_2</item>
    </style>

    <style name="Theme.MainApp" parent="Base.Theme.MainApp" />

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.TopRightRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">10dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

</resources>